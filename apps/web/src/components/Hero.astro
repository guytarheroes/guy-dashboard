---
import { Image } from "astro:assets";
import hero from "../assets/hero-bali.jpg";
---

<section class="relative flex min-h-svh items-end overflow-hidden">
  <Image
    src={hero}
    alt="Tanah Lot temple silhouetted on a sea rock at sunset, Bali"
    widths={[900, 1400, 2000, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="kenburns absolute inset-0 h-full w-full object-cover"
  />

  {/* ไล่เฉดสองชั้น: ชั้นล่างให้ตัวหนังสืออ่านออก ชั้นบนให้ nav ขาวไม่จม */}
  <div class="scrim absolute inset-0"></div>

  <div class="relative mx-auto w-full max-w-6xl px-6 pb-24 pt-40 sm:pb-32">
    <p class="rise eyebrow text-sm tracking-[0.28em] uppercase" style="--d:200ms">
      Small-group journeys
    </p>

    <h1 class="font-display mt-6 max-w-3xl text-5xl leading-[1.05] font-normal text-white sm:text-7xl">
      <span class="rise block" style="--d:380ms">Go slowly.</span>
      <span class="rise block italic" style="--d:520ms">See properly.</span>
    </h1>

    <p class="rise mt-7 max-w-md text-lg text-white/75" style="--d:680ms">
      Eight travellers, one local host, and an itinerary with room to breathe.
    </p>

    <div class="rise mt-10 flex flex-wrap items-center gap-5" style="--d:820ms">
      <a href="#destinations" class="book rounded-full px-7 py-3.5 text-sm font-medium">
        See where we go
      </a>
      <a href="#approach" class="underline-sweep text-sm text-white/80"> How it works </a>
    </div>
  </div>

  <a href="#destinations" class="cue nudge" aria-label="Scroll to destinations">
    <svg width="20" height="30" viewBox="0 0 20 30" fill="none" aria-hidden="true">
      <rect x="1" y="1" width="18" height="28" rx="9" stroke="currentColor" stroke-width="1.5"></rect>
      <circle cx="10" cy="9" r="2" fill="currentColor"></circle>
    </svg>
  </a>
</section>

<style>
  .scrim {
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.72) 0%, rgb(0 0 0 / 0.25) 45%, rgb(0 0 0 / 0.1) 70%),
      linear-gradient(to bottom, rgb(0 0 0 / 0.35), transparent 30%);
  }

  .eyebrow {
    color: rgb(255 255 255 / 0.75);
  }

  .book {
    background: #fff;
    color: #16150f;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s ease;
  }

  .book:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.28);
  }

  .cue {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 1.75rem;
    margin-inline: auto;
    inline-size: 20px;
    color: #fff;
  }
</style>
