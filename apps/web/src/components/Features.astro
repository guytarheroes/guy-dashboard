---
const points = [
  {
    title: "Eight seats",
    body: "Group trips stop working somewhere around nine people. So we stop at eight.",
    path: "M4 19c0-3 2.4-4.5 5-4.5S14 16 14 19M9 5.5a3.2 3.2 0 1 1 0 6.4 3.2 3.2 0 0 1 0-6.4M16 19c0-2.2 1-3.6 2.6-4.3M16.6 6.2a2.8 2.8 0 1 1 0 5.6",
  },
  {
    title: "Local hosts",
    body: "Someone who lives there, not a guide flown in for the week. They pick the table.",
    path: "M12 21s7-5.4 7-10.5A7 7 0 0 0 5 10.5C5 15.6 12 21 12 21Z M12 8.2a2.4 2.4 0 1 1 0 4.8 2.4 2.4 0 0 1 0-4.8",
  },
  {
    title: "Half-empty days",
    body: "Two fixed things a day, maximum. The rest is yours to waste properly.",
    path: "M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17M12 7.5V12l3 1.8",
  },
];
---

<section id="approach" class="edge">
  <div class="mx-auto max-w-6xl px-6 py-28 sm:py-36">
    <h2 class="reveal font-display max-w-lg text-4xl leading-tight sm:text-5xl">
      The rules we<br /><span class="italic">refuse</span> to break
    </h2>

    <dl class="mt-16 grid gap-12 sm:grid-cols-3">
      {
        points.map((point, i) => (
          <div class="reveal" style={`--d:${i * 120}ms`}>
            <svg
              class="text-accent"
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={point.path} />
            </svg>
            <dt class="font-display mt-5 text-xl">{point.title}</dt>
            <dd class="text-muted mt-2.5 text-sm leading-relaxed">{point.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .edge {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }
</style>
